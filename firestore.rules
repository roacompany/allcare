rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 사용자별 데이터 ---
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // babies 및 하위 컬렉션 (activities, growth, diary, vaccinations, milestones, weeklyMetrics)
      match /babies/{babyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        match /{subcollection}/{docId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // 공유된 아기: sharedAccess 문서가 존재하면 타 사용자 데이터 읽기+쓰기 허용
      match /babies/{babyId} {
        allow read, write: if request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/sharedAccess/$(userId + "_" + babyId));
        match /{subcollection}/{docId} {
          allow read, write: if request.auth != null
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/sharedAccess/$(userId + "_" + babyId));
        }
      }

      // 사용자 레벨 서브컬렉션 — 본인만
      match /todos/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /routines/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /dayPlans/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /dayRuns/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /products/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /hospitalVisits/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /vaccinations/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /milestones/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /diary/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /purchases/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /premiumStatus/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // sharedAccess — 본인 경로. 읽기/수정/삭제는 본인, 생성은 유효한 초대코드 교차검증.
      // (생성만 조이는 이유: 기존 공유 문서는 inviteCode 필드가 없어도 read/update/delete 로 유지)
      match /sharedAccess/{docId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && docId == request.resource.data.ownerUserId + "_" + request.resource.data.babyId
          && request.resource.data.inviteCode is string
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.ownerUserId == request.resource.data.ownerUserId
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.babyId == request.resource.data.babyId
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.isUsed == false
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt > request.time;
      }

      // FCM 토큰 — 본인만
      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 배지 — 본인만 읽기/쓰기 (FirestoreService+Badge: 중복 방지 get→set 단일 경로)
      match /badges/{badgeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 누적 통계 — 본인만 읽기/쓰기 (FieldValue.increment + merge:true)
      match /stats/{statsId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // --- 임신 모드 (Pregnancy Mode) ---
      // 임신 루트 문서: 본인 또는 파트너(sharedWith 포함) 읽기, 쓰기는 본인만
      match /pregnancies/{pregnancyId} {
        allow read: if request.auth != null
          && (
            request.auth.uid == userId
            || (resource != null && resource.data.sharedWith is list
                && request.auth.uid in resource.data.sharedWith)
          );
        allow write: if request.auth != null && request.auth.uid == userId;

        // 임신 하위 서브컬렉션 (kickSessions, prenatalVisits, pregnancyChecklists, pregnancyWeights)
        match /{subcollection}/{docId} {
          allow read: if request.auth != null
            && (
              request.auth.uid == userId
              || (
                exists(/databases/$(database)/documents/users/$(userId)/pregnancies/$(pregnancyId))
                && get(/databases/$(database)/documents/users/$(userId)/pregnancies/$(pregnancyId)).data.sharedWith is list
                && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)/pregnancies/$(pregnancyId)).data.sharedWith
              )
            );
          allow write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // --- AI 주간 하이라이트 캐시 ---
    // highlightCache는 babies 하위 서브컬렉션이므로 위 /babies/{babyId}/{subcollection}/{docId} 규칙에 포함되지만
    // metricKey allowlist (defense in depth) 를 위해 별도 명시.
    match /users/{uid}/babies/{bid}/highlightCache/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.metricKey.matches('^(feeding|sleep|diaper|health)_.+');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // --- 임신 모드 collectionGroup: 파트너 read (sharedWith) ---
    // collectionGroup 쿼리 (fetchSharedPregnancy) 지원: sharedWith 포함 사용자 read 허용
    match /{path=**}/pregnancies/{pregnancyId} {
      allow read: if request.auth != null
        && resource != null
        && resource.data.sharedWith is list
        && request.auth.uid in resource.data.sharedWith;
    }

    // --- 초대 ---
    // 문서 ID = 초대코드. 코드를 아는 사람만 단건 조회(get) — 목록 열거(list)는 차단.
    // (수락 시 sharedAccess 생성 규칙이 이 문서를 code 로 교차검증한다)
    match /invites/{code} {
      // 코드를 아는 단건 조회만 허용
      allow get: if request.auth != null;
      // 목록은 「내가 만든 초대」만(조건 ownerUserId == 나) — 남의 초대 열거는 계속 막힌다.
      // 2.8.13 앱이 아기 삭제·계정 삭제 끝에 이 조회로 자기 초대를 지운다(막으면 그 삭제가 「실패」로 끝났다 · 2026-11-11~14)
      allow list: if request.auth != null && resource.data.ownerUserId == request.auth.uid;
      // 소유자만 생성 (ownerUserId == 본인, 문서ID == code)
      allow create: if request.auth != null
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.code == code;
      // 소유자만 수정 또는 인증 사용자가 isUsed만 true로 변경
      allow update: if request.auth != null
        && (
          resource.data.ownerUserId == request.auth.uid
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isUsed"])
            && request.resource.data.isUsed == true
            && resource.data.isUsed == false
          )
        );
      // 소유자만 삭제
      allow delete: if request.auth != null && resource.data.ownerUserId == request.auth.uid;
    }

    // --- 공지사항: 인증 사용자 읽기, 관리자만 쓰기 ---
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == "8EAUezvUyYTzhNVw9VO6GKKyhhx2";
    }

    // --- 상품 카탈로그: 인증 사용자 읽기, 관리자만 쓰기 ---
    match /productCatalog/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == "8EAUezvUyYTzhNVw9VO6GKKyhhx2";
    }
  }
}
